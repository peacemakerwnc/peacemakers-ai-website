# Local / non-Production owner-ops environment template.
# Copy to `.env` locally — never commit real secrets.
# Do NOT use Production Neon, Resend, or Upstash credentials for local tests.

# Runtime PostgreSQL connection (pooled URL on Neon in Production).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct (non-pooled) PostgreSQL URL for Prisma migrate tooling only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional: dedicated non-Production Postgres for `npm run test:db`.
# Never set this to Production Neon. Prefer local Docker Postgres when authorized.
# OWNER_OPS_TEST_DATABASE_URL="postgresql://owner_ops_test:owner_ops_test@127.0.0.1:5432/owner_ops_test?schema=public"

# Owner login (seed creates this user if missing)
OWNER_EMAIL="owner@peacemakersai.com"
OWNER_NAME="James Fullen"
OWNER_PASSWORD="change-me-before-use"

# Session signing secret — use a long random string (32+ bytes)
SESSION_SECRET="dev-only-replace-with-long-random-secret-32chars-min"

# Absolute or relative path outside public/; never under /public
STORAGE_ROOT="./storage"

# Public base URL for invitation links (local)
APP_BASE_URL="http://localhost:3001"

# Optional: days until invitation expires (default 30)
FORM_INVITATION_EXPIRY_DAYS="30"

# Optional: days for review next-action due date (default 3)
REVIEW_ACTION_DUE_DAYS="3"

# --- Pilot production (set in host env UI; never commit real values) ---
# NODE_ENV=production
# DATABASE_URL=<Neon pooled connection string>
# DIRECT_URL=<Neon direct/non-pooled connection string>
# APP_BASE_URL=https://your-pilot-host.example
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Peacemakers AI <forms@your-verified-domain>"
# RATE_LIMIT_BACKEND=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
# DISABLE_CLIENT_UPLOADS=true
# ALLOW_LOG_EMAIL_IN_PRODUCTION=false
#
# Production init: run `npm run db:seed` only under a separately authorized
# gate (owner + pipeline/template only). Never run `prisma/seed-demo-uat.ts`
# against Production. Never `prisma migrate reset` / `db push` on Production.
