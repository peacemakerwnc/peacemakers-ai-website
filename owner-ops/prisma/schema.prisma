// Owner Operations Dashboard — Phase 1
// SQLite for local development. Schema kept Postgres-compatible
// (portable types; switch provider + DATABASE_URL for production).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  NURTURE
}

enum FormInvitationStatus {
  PENDING
  SENT
  OPENED
  IN_PROGRESS
  SUBMITTED
  REVOKED
  EXPIRED
}

enum FormResponseStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED
}

enum NextActionStatus {
  OPEN
  DONE
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FileAccessLevel {
  OWNER_ONLY
  INVITATION_SCOPED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  SUPERSEDED
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

enum PaymentStatus {
  DRAFT
  SENT
  PAID
  VOID
  OVERDUE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isOwner      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedOpportunities Opportunity[] @relation("OpportunityOwner")
  assignedActions       NextAction[]  @relation("ActionAssignee")
  notes                 Note[]
  auditEvents           AuditEvent[]
  reviewedResponses     FormResponse[] @relation("ResponseReviewer")
}

model Company {
  id                    String   @id @default(cuid())
  name                  String
  website               String?
  primaryLocation       String?
  serviceAreas          String?
  industry              String?
  yearsInBusiness       Int?
  employeeCount         Int?
  adminEmployeeCount    Int?
  customersPerMonth     Int?
  annualRevenueRange    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contacts       CompanyContact[]
  opportunities  Opportunity[]
  tools          CompanyTool[]
  files          FileAttachment[]
  notes          Note[]
  activities     Activity[]
  meetings       Meeting[]
  proposals      Proposal[]
  agreements     Agreement[]
  payments       Payment[]
  projects       Project[]
}

model Contact {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  jobTitle        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companies       CompanyContact[]
  opportunities   Opportunity[]
  formInvitations FormInvitation[]
  notes           Note[]
  activities      Activity[]
  meetings        Meeting[]
  files           FileAttachment[]

  @@index([email])
}

model CompanyContact {
  id        String   @id @default(cuid())
  companyId String
  contactId String
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([companyId, contactId])
}

model Pipeline {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]
}

model PipelineStage {
  id                 String   @id @default(cuid())
  pipelineId         String
  name               String
  slug               String
  sortOrder          Int
  objective          String
  requiredInformation String @default("")
  requiredOwnerAction String @default("")
  clientFacingArtifact String?
  suggestedMessage   String?
  relevantSopSlug    String?
  exitCriteria       String  @default("")
  nextStageSlug      String?
  isTerminal         Boolean @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pipeline    Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  checklists  StageChecklist[]
  opportunities Opportunity[]

  @@unique([pipelineId, slug])
  @@index([pipelineId, sortOrder])
}

model StageChecklist {
  id          String  @id @default(cuid())
  stageId     String
  label       String
  sortOrder   Int     @default(0)
  isRequired  Boolean @default(true)

  stage PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId, sortOrder])
}

model Opportunity {
  id              String            @id @default(cuid())
  pipelineId      String
  stageId         String
  contactId       String
  companyId       String
  ownerUserId     String?
  title           String
  status          OpportunityStatus @default(OPEN)
  estimatedValue  Int?
  formStatus      FormInvitationStatus?
  lastActivityAt  DateTime?
  nextActionDueAt DateTime?
  source          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  pipeline        Pipeline         @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage    @relation(fields: [stageId], references: [id])
  contact         Contact          @relation(fields: [contactId], references: [id])
  company         Company          @relation(fields: [companyId], references: [id])
  owner           User?            @relation("OpportunityOwner", fields: [ownerUserId], references: [id])
  formInvitations FormInvitation[]
  activities      Activity[]
  notes           Note[]
  meetings        Meeting[]
  nextActions     NextAction[]
  files           FileAttachment[]
  proposals       Proposal[]
  agreements      Agreement[]
  payments        Payment[]
  projects        Project[]

  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
  @@index([status])
  @@index([nextActionDueAt])
}

model FormTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  version     Int      @default(1)
  description String?
  schemaJson  String   @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invitations FormInvitation[]
}

model FormInvitation {
  id               String                @id @default(cuid())
  tokenHash        String                @unique
  tokenPrefix      String
  formTemplateId   String
  contactId        String
  opportunityId    String
  status           FormInvitationStatus  @default(PENDING)
  expiresAt        DateTime
  revokedAt        DateTime?
  firstOpenedAt    DateTime?
  lastSavedAt      DateTime?
  submittedAt      DateTime?
  completionPct    Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  formTemplate FormTemplate   @relation(fields: [formTemplateId], references: [id])
  contact      Contact        @relation(fields: [contactId], references: [id])
  opportunity  Opportunity    @relation(fields: [opportunityId], references: [id])
  responses    FormResponse[]
  files        FileAttachment[]
  activities   Activity[]

  @@index([opportunityId])
  @@index([contactId])
  @@index([status])
  @@index([expiresAt])
}

model FormResponse {
  id              String             @id @default(cuid())
  invitationId    String
  version         Int                @default(1)
  status          FormResponseStatus @default(DRAFT)
  payloadJson     String             @default("{}")
  completionPct   Int                @default(0)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  internalNotes   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  invitation FormInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("ResponseReviewer", fields: [reviewedById], references: [id])
  processes  Process[]
  tools      CompanyTool[]
  files      FileAttachment[]

  @@unique([invitationId, version])
  @@index([invitationId, status])
}

model Process {
  id                    String   @id @default(cuid())
  formResponseId        String
  name                  String
  department            String?
  processOwner          String?
  peopleInvolved        String?
  frequency             String?
  estimatedTime         String?
  businessImportance    String?
  frustrationLevel      String?
  errorReworkFrequency  String?
  affectsRevenue        Boolean  @default(false)
  affectsCustomerExp    Boolean  @default(false)
  affectsCost           Boolean  @default(false)
  affectsRisk           Boolean  @default(false)
  affectsWorkload       Boolean  @default(false)
  wantDetailedMap       Boolean  @default(false)
  category              String?
  isDetailedMap         Boolean  @default(false)
  businessObjective     String?
  averageVolume         String?
  averageCompletionTime String?
  detailJson            String   @default("{}")
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  formResponse FormResponse  @relation(fields: [formResponseId], references: [id], onDelete: Cascade)
  steps        ProcessStep[]

  @@index([formResponseId])
}

model ProcessStep {
  id                 String   @id @default(cuid())
  processId          String
  stepNumber         Int
  responsibleRole    String?
  exactAction        String?
  toolUsed           String?
  informationReceived String?
  informationChanged String?
  outputRecipient    String?
  decisionInvolved   String?
  expectedTime       String?
  waitingTime        String?
  notificationSent   String?
  completionEvidence String?
  problems           String?
  exceptions         String?
  workaround         String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, sortOrder])
}

model Tool {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  companyTools CompanyTool[]
}

model CompanyTool {
  id              String   @id @default(cuid())
  companyId       String?
  formResponseId  String?
  toolId          String?
  name            String
  category        String?
  usedFor         String?
  whoUses         String?
  informationHeld String?
  connectsTo      String?
  worksWell       String?
  doesNotWorkWell String?
  costOptional    String?
  retainDecision  String?
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  formResponse FormResponse? @relation(fields: [formResponseId], references: [id], onDelete: Cascade)
  tool         Tool?         @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([formResponseId])
}

model FileAttachment {
  id               String          @id @default(cuid())
  storageKey       String          @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  accessLevel      FileAccessLevel @default(OWNER_ONLY)
  category         String?
  companyId        String?
  contactId        String?
  opportunityId    String?
  invitationId     String?
  formResponseId   String?
  uploadedByOwner  Boolean         @default(false)
  createdAt        DateTime        @default(now())

  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  invitation   FormInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  formResponse FormResponse?  @relation(fields: [formResponseId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([invitationId])
  @@index([formResponseId])
}

model Activity {
  id            String   @id @default(cuid())
  type          String
  summary       String
  detailsJson   String   @default("{}")
  actorType     String   @default("system")
  actorLabel    String?
  opportunityId String?
  contactId     String?
  companyId     String?
  invitationId  String?
  createdAt     DateTime @default(now())

  opportunity Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invitation  FormInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
  @@index([contactId, createdAt])
  @@index([companyId, createdAt])
}

model Note {
  id            String   @id @default(cuid())
  body          String
  authorUserId  String?
  opportunityId String?
  contactId     String?
  companyId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([contactId])
  @@index([companyId])
}

model Meeting {
  id            String        @id @default(cuid())
  title         String
  meetingType   String
  status        MeetingStatus @default(SCHEDULED)
  scheduledAt   DateTime?
  completedAt   DateTime?
  locationOrUrl String?
  notes         String?
  opportunityId String?
  contactId     String?
  companyId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([scheduledAt])
}

model NextAction {
  id            String           @id @default(cuid())
  title         String
  description   String?
  status        NextActionStatus @default(OPEN)
  dueAt         DateTime?
  completedAt   DateTime?
  opportunityId String?
  assigneeId    String?
  source        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([opportunityId, status])
  @@index([dueAt])
  @@index([status])
}

model Proposal {
  id            String         @id @default(cuid())
  opportunityId String?
  companyId     String?
  title         String
  status        ProposalStatus @default(DRAFT)
  amountCents   Int?
  summary       String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Agreement {
  id            String          @id @default(cuid())
  opportunityId String?
  companyId     String?
  title         String
  status        AgreementStatus @default(DRAFT)
  signedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Payment {
  id            String        @id @default(cuid())
  opportunityId String?
  companyId     String?
  title         String
  status        PaymentStatus @default(DRAFT)
  amountCents   Int?
  dueAt         DateTime?
  paidAt        DateTime?
  externalRef   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Project {
  id            String        @id @default(cuid())
  opportunityId String?
  companyId     String?
  name          String
  status        ProjectStatus @default(PLANNED)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  opportunity Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stages      ProjectStage[]
}

model ProjectStage {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  sortOrder  Int       @default(0)
  status     String    @default("pending")
  startedAt  DateTime?
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Sop {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  stageSlug   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Template {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  kind        String
  body        String
  stageSlug   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  actorUserId String?
  actorLabel String   @default("system")
  entityType String?
  entityId   String?
  detailsJson String  @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}
