// Owner Operations Dashboard — Phase 1
// SQLite for local development. Schema kept Postgres-compatible
// (portable types; switch provider + DATABASE_URL for production).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  NURTURE
}

enum FormInvitationStatus {
  PENDING
  SENT
  OPENED
  IN_PROGRESS
  SUBMITTED
  REVOKED
  EXPIRED
}

enum FormResponseStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED
}

enum NextActionStatus {
  OPEN
  DONE
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FileAccessLevel {
  OWNER_ONLY
  INVITATION_SCOPED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  SUPERSEDED
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

enum PaymentStatus {
  DRAFT
  SENT
  PAID
  VOID
  OVERDUE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// Phase 1.1 Increment 1 — relational process graph
enum ProcessStatus {
  ACTIVE
  ARCHIVED
}

enum ProcessVersionClassification {
  AS_IS
  FUTURE_STATE
}

enum ProcessVersionStatus {
  DRAFT
  SUBMITTED
  OWNER_REFINED
  APPROVED
  SUPERSEDED
}

enum ProcessAuthorType {
  CLIENT
  OWNER
  SYSTEM
}

enum ProcessStepType {
  TRIGGER
  HUMAN_TASK
  AUTOMATED_TASK
  COMMUNICATION
  DATA_ENTRY
  DOCUMENT_CREATION
  DECISION
  APPROVAL
  HANDOFF
  WAITING_PERIOD
  EXCEPTION
  SUBPROCESS
  PROCESS_END
}

enum ProcessExecutionType {
  HUMAN
  SYSTEM
  HYBRID
}

enum ProcessConnectionType {
  NORMAL
  CONDITIONAL
  APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
  PARALLEL
  LOOP
  REWORK
  ESCALATION
  TIMEOUT
  FAILURE
  TERMINATION
}

enum ProcessParticipantType {
  ROLE
  PERSON
  DEPARTMENT
  CUSTOMER
  VENDOR
  SYSTEM
  EXTERNAL
}

enum ProcessResponsibilityType {
  ACCOUNTABLE
  RESPONSIBLE
  CONSULTED
  INFORMED
  APPROVER
  EXECUTOR
}

enum ProcessApprovalType {
  AS_IS_BASELINE
  FUTURE_STATE_BASELINE
  OWNER_REVIEW
}

enum ProcessApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

// Phase 1.1 Increment 3 — owner visual workspace analytics
enum ProcessSwimlaneKind {
  ROLE
  DEPARTMENT
  PARTICIPANT
  SYSTEM
  EXTERNAL
  UNASSIGNED
}

enum PainPointCategory {
  DELAY_WAITING
  DUPLICATE_ENTRY
  MANUAL_TRANSFER
  ERROR_REWORK
  APPROVAL_BOTTLENECK
  HANDOFF_FAILURE
  SYSTEM_LIMITATION
  MISSING_INFORMATION
  COMMUNICATION_FAILURE
  COMPLIANCE_RISK
  CUSTOMER_EXPERIENCE
  OTHER
}

enum PainPointSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MetricType {
  VOLUME
  WORK_TIME
  WAIT_TIME
  TOTAL_CYCLE_TIME
  ERROR_RATE
  REWORK_RATE
  APPROVAL_TIME
  COST
  CUSTOMER_RESPONSE_TIME
  COMPLETION_RATE
  OTHER
}

enum MetricDataSource {
  CLIENT_PROVIDED
  OWNER_ESTIMATE
  VERIFIED_MEASUREMENT
}

enum ImprovementCategory {
  ELIMINATE
  SIMPLIFY
  STANDARDIZE
  AUTOMATE
  INTEGRATE
  IMPROVE_HANDOFF
  IMPROVE_CONTROLS
  IMPROVE_REPORTING
  IMPROVE_CUSTOMER_COMMUNICATION
  REDESIGN_RESPONSIBILITY
  OTHER
}

enum ImprovementStatus {
  CAPTURED
  UNDER_REVIEW
  CANDIDATE
  DEFERRED
  REJECTED
  IMPLEMENTED
}

enum ImprovementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FormProcessMigrationStatus {
  UNREVIEWED
  PRESERVED_LINEAR
  LINKED_TO_GRAPH
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isOwner      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedOpportunities Opportunity[] @relation("OpportunityOwner")
  assignedActions       NextAction[]  @relation("ActionAssignee")
  notes                 Note[]
  auditEvents           AuditEvent[]
  reviewedResponses     FormResponse[] @relation("ResponseReviewer")
}

model Company {
  id                    String   @id @default(cuid())
  name                  String
  website               String?
  primaryLocation       String?
  serviceAreas          String?
  industry              String?
  yearsInBusiness       Int?
  employeeCount         Int?
  adminEmployeeCount    Int?
  customersPerMonth     Int?
  annualRevenueRange    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contacts       CompanyContact[]
  opportunities  Opportunity[]
  tools          CompanyTool[]
  files          FileAttachment[]
  notes          Note[]
  activities     Activity[]
  meetings       Meeting[]
  blueprintMeetings BlueprintMeeting[]
  proposals      Proposal[]
  agreements     Agreement[]
  payments       Payment[]
  projects       Project[]
  processes      Process[]
  evidenceSources EvidenceSource[]
  evidenceFindings EvidenceFinding[]
  evidenceConflicts EvidenceConflict[]
}

model Contact {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  jobTitle        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companies       CompanyContact[]
  opportunities   Opportunity[]
  formInvitations FormInvitation[]
  notes           Note[]
  activities      Activity[]
  meetings        Meeting[]
  files           FileAttachment[]

  @@index([email])
}

model CompanyContact {
  id        String   @id @default(cuid())
  companyId String
  contactId String
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([companyId, contactId])
}

model Pipeline {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]
}

model PipelineStage {
  id                 String   @id @default(cuid())
  pipelineId         String
  name               String
  slug               String
  sortOrder          Int
  objective          String
  requiredInformation String @default("")
  requiredOwnerAction String @default("")
  clientFacingArtifact String?
  suggestedMessage   String?
  relevantSopSlug    String?
  exitCriteria       String  @default("")
  nextStageSlug      String?
  isTerminal         Boolean @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pipeline    Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  checklists  StageChecklist[]
  opportunities Opportunity[]

  @@unique([pipelineId, slug])
  @@index([pipelineId, sortOrder])
}

model StageChecklist {
  id          String  @id @default(cuid())
  stageId     String
  label       String
  sortOrder   Int     @default(0)
  isRequired  Boolean @default(true)

  stage PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId, sortOrder])
}

model Opportunity {
  id              String            @id @default(cuid())
  pipelineId      String
  stageId         String
  contactId       String
  companyId       String
  ownerUserId     String?
  title           String
  status          OpportunityStatus @default(OPEN)
  estimatedValue  Int?
  formStatus      FormInvitationStatus?
  lastActivityAt  DateTime?
  nextActionDueAt DateTime?
  source          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  pipeline         Pipeline          @relation(fields: [pipelineId], references: [id])
  stage            PipelineStage     @relation(fields: [stageId], references: [id])
  contact          Contact           @relation(fields: [contactId], references: [id])
  company          Company           @relation(fields: [companyId], references: [id])
  owner            User?             @relation("OpportunityOwner", fields: [ownerUserId], references: [id])
  formInvitations  FormInvitation[]
  activities       Activity[]
  notes            Note[]
  meetings         Meeting[]
  blueprintMeetings BlueprintMeeting[]
  nextActions      NextAction[]
  files            FileAttachment[]
  proposals        Proposal[]
  agreements       Agreement[]
  payments         Payment[]
  projects         Project[]
  proposedServices ProposedService[]
  processes        Process[]
  evidenceSources  EvidenceSource[]
  evidenceFindings EvidenceFinding[]
  evidenceConflicts EvidenceConflict[]

  @@index([stageId])
  @@index([companyId])
  @@index([contactId])
  @@index([status])
  @@index([nextActionDueAt])
}

model ProposedService {
  id            String   @id @default(cuid())
  opportunityId String
  name          String
  status        String   @default("proposed")
  notes         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, sortOrder])
}

model FormTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  version     Int      @default(1)
  description String?
  schemaJson  String   @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invitations FormInvitation[]
}

model FormInvitation {
  id                     String                @id @default(cuid())
  tokenHash              String                @unique
  tokenPrefix            String
  formTemplateId         String
  contactId              String
  opportunityId          String
  status                 FormInvitationStatus  @default(PENDING)
  expiresAt              DateTime
  revokedAt              DateTime?
  firstOpenedAt          DateTime?
  lastSavedAt            DateTime?
  submittedAt            DateTime?
  completionPct          Int                   @default(0)
  /// Pilot privacy notice version acknowledged by the client (e.g. pilot-2026-08-05)
  privacyNoticeVersion   String?
  privacyAcknowledgedAt  DateTime?
  lastEmailSentAt        DateTime?
  lastEmailProvider      String?
  lastEmailMessageId     String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  formTemplate FormTemplate   @relation(fields: [formTemplateId], references: [id])
  contact      Contact        @relation(fields: [contactId], references: [id])
  opportunity  Opportunity    @relation(fields: [opportunityId], references: [id])
  responses    FormResponse[]
  files        FileAttachment[]
  activities   Activity[]

  @@index([opportunityId])
  @@index([contactId])
  @@index([status])
  @@index([expiresAt])
}

model FormResponse {
  id              String             @id @default(cuid())
  invitationId    String
  version         Int                @default(1)
  status          FormResponseStatus @default(DRAFT)
  payloadJson     String             @default("{}")
  completionPct   Int                @default(0)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  internalNotes   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  invitation FormInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("ResponseReviewer", fields: [reviewedById], references: [id])
  formProcesses FormProcess[]
  processVersions ProcessVersion[]
  tools        CompanyTool[]
  files        FileAttachment[]
  blueprintMeetings BlueprintMeeting[]
  evidenceSources EvidenceSource[]

  @@unique([invitationId, version])
  @@index([invitationId, status])
}

/// Legacy Blueprint-form capture (Phase 1). Linear prose/order only — not the graph source of truth.
model FormProcess {
  id                    String                     @id @default(cuid())
  formResponseId        String
  name                  String
  department            String?
  processOwner          String?
  peopleInvolved        String?
  frequency             String?
  estimatedTime         String?
  businessImportance    String?
  frustrationLevel      String?
  errorReworkFrequency  String?
  affectsRevenue        Boolean                    @default(false)
  affectsCustomerExp    Boolean                    @default(false)
  affectsCost           Boolean                    @default(false)
  affectsRisk           Boolean                    @default(false)
  affectsWorkload       Boolean                    @default(false)
  wantDetailedMap       Boolean                    @default(false)
  category              String?
  isDetailedMap         Boolean                    @default(false)
  businessObjective     String?
  averageVolume         String?
  averageCompletionTime String?
  detailJson            String                     @default("{}")
  sortOrder             Int                        @default(0)
  /// Increment 1: preserved without fabricating graph edges.
  migrationStatus       FormProcessMigrationStatus @default(UNREVIEWED)
  linkedProcessId       String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  formResponse FormResponse      @relation(fields: [formResponseId], references: [id], onDelete: Cascade)
  steps        FormProcessStep[]
  linkedProcess Process?         @relation(fields: [linkedProcessId], references: [id], onDelete: SetNull)

  @@index([formResponseId])
  @@index([migrationStatus])
  @@index([linkedProcessId])
}

model FormProcessStep {
  id                  String   @id @default(cuid())
  processId           String
  stepNumber          Int
  responsibleRole     String?
  exactAction         String?
  toolUsed            String?
  informationReceived String?
  informationChanged  String?
  outputRecipient     String?
  decisionInvolved    String?
  expectedTime        String?
  waitingTime         String?
  notificationSent    String?
  completionEvidence  String?
  problems            String?
  exceptions          String?
  workaround          String?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  process FormProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, sortOrder])
}

/// Durable business-process identity for the relational graph (Phase 1.1).
model Process {
  id                           String        @id @default(cuid())
  companyId                    String
  opportunityId                String?
  name                         String
  purpose                      String?
  customerOutcome              String?
  processOwner                 String?
  status                       ProcessStatus @default(ACTIVE)
  currentDraftVersionId        String?
  currentApprovedAsIsVersionId String?
  currentFutureStateVersionId  String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  versions    ProcessVersion[]
  formSources FormProcess[]

  @@index([companyId])
  @@index([opportunityId])
  @@index([status])
}

model ProcessVersion {
  id                    String                       @id @default(cuid())
  processId             String
  versionNumber         Int
  versionLabel          String?
  classification        ProcessVersionClassification
  status                ProcessVersionStatus         @default(DRAFT)
  parentVersionId       String?
  derivedFromVersionId  String?
  authorType            ProcessAuthorType            @default(OWNER)
  authorUserId          String?
  authorLabel           String?
  purpose               String?
  outcome               String?
  startTrigger          String?
  endEvent              String?
  startBoundary         String?
  endBoundary           String?
  frequency             String?
  averageVolume         String?
  peakVolume            String?
  averageCompletionTime String?
  governingRules        String?
  policies              String?
  contractualObligations String?
  deadlines             String?
  serviceExpectations   String?
  successMeasures       String?
  currentPerformance    String?
  internalNotes         String?
  clientNotes           String?
  completenessStatus    String?
  confidenceStatus      String?
  /// Questionnaire response version that owns this process version (Increment 2).
  formResponseId        String?
  /// Presentation-only viewport JSON for the owner workspace (Increment 3).
  viewportJson          String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  submittedAt           DateTime?
  approvedAt            DateTime?
  supersededAt          DateTime?

  process      Process              @relation(fields: [processId], references: [id], onDelete: Cascade)
  formResponse FormResponse?        @relation(fields: [formResponseId], references: [id], onDelete: SetNull)
  parent       ProcessVersion?      @relation("VersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children     ProcessVersion[]     @relation("VersionParent")
  derivedFrom  ProcessVersion?      @relation("VersionDerived", fields: [derivedFromVersionId], references: [id], onDelete: SetNull)
  derivatives  ProcessVersion[]     @relation("VersionDerived")
  steps        ProcessStep[]
  connections  ProcessConnection[]
  participants ProcessParticipant[]
  approvals    ProcessApproval[]
  swimlanes    ProcessSwimlane[]
  painPoints   ProcessPainPoint[]
  metrics      ProcessMetric[]
  opportunities ImprovementOpportunity[]

  @@unique([processId, versionNumber])
  @@index([processId, status])
  @@index([classification])
  @@index([parentVersionId])
  @@index([derivedFromVersionId])
  @@index([formResponseId])
}

model ProcessStep {
  id                   String               @id @default(cuid())
  processVersionId     String
  displayOrder         Int                  @default(0)
  shortName            String
  detailedDescription  String?
  stepType             ProcessStepType
  responsibleRole      String?
  responsiblePerson    String?
  department           String?
  executionType        ProcessExecutionType @default(HUMAN)
  toolOrSystem         String?
  requiredInputs       String?
  dataReceived         String?
  informationHandled   String?
  outputProduced       String?
  outputRecipient      String?
  expectedWorkTime     String?
  typicalWaitingTime   String?
  deadline             String?
  serviceExpectation   String?
  notification         String?
  evidenceOfCompletion String?
  problems             String?
  workarounds          String?
  valueClassification  String?
  automationSuitability String?
  internalNotes        String?
  clientNotes          String?
  unresolvedQuestions  String?
  /// Client marker: explain during Blueprint call (Increment 2).
  discussDuringBlueprint Boolean            @default(false)
  completenessStatus   String?
  confidenceStatus     String?
  /// Presentation only — never workflow truth.
  canvasX              Float?
  canvasY              Float?
  /// Swimlane assignment — presentation/responsibility only (Increment 3).
  swimlaneId           String?
  /// Step copied from this source step id when refining/deriving (Increment 3).
  sourceStepId         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  processVersion ProcessVersion       @relation(fields: [processVersionId], references: [id], onDelete: Cascade)
  swimlane       ProcessSwimlane?     @relation(fields: [swimlaneId], references: [id], onDelete: SetNull)
  sourceStep     ProcessStep?         @relation("StepLineage", fields: [sourceStepId], references: [id], onDelete: SetNull)
  derivedSteps   ProcessStep[]        @relation("StepLineage")
  outgoing       ProcessConnection[]  @relation("ConnectionSource")
  incoming       ProcessConnection[]  @relation("ConnectionTarget")
  participants   ProcessParticipant[]
  painPoints     ProcessPainPoint[]
  metrics        ProcessMetric[]
  opportunities  ImprovementOpportunity[]

  @@index([processVersionId, displayOrder])
  @@index([stepType])
  @@index([swimlaneId])
  @@index([sourceStepId])
}

model ProcessConnection {
  id                   String                @id @default(cuid())
  processVersionId     String
  sourceStepId         String
  targetStepId         String
  connectionType       ProcessConnectionType
  displayLabel         String?
  condition            String?
  businessRule         String?
  priority             Int                   @default(0)
  isDefaultPath        Boolean               @default(false)
  exceptionMetadata    String?
  escalationMetadata   String?
  presentationRouteJson String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  processVersion ProcessVersion       @relation(fields: [processVersionId], references: [id], onDelete: Cascade)
  sourceStep     ProcessStep          @relation("ConnectionSource", fields: [sourceStepId], references: [id], onDelete: Restrict)
  targetStep     ProcessStep          @relation("ConnectionTarget", fields: [targetStepId], references: [id], onDelete: Restrict)

  @@index([processVersionId])
  @@index([sourceStepId])
  @@index([targetStepId])
  @@index([connectionType])
}

model ProcessParticipant {
  id                 String                    @id @default(cuid())
  processVersionId   String
  processStepId      String?
  participantType    ProcessParticipantType
  role               String?
  personLabel        String?
  contactId          String?
  department         String?
  externalDesignation String?
  responsibilityType ProcessResponsibilityType @default(RESPONSIBLE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  processVersion ProcessVersion @relation(fields: [processVersionId], references: [id], onDelete: Cascade)
  processStep    ProcessStep?   @relation(fields: [processStepId], references: [id], onDelete: Cascade)

  @@index([processVersionId])
  @@index([processStepId])
  @@index([contactId])
}

model ProcessApproval {
  id               String                @id @default(cuid())
  processVersionId String
  approvalType     ProcessApprovalType
  status           ProcessApprovalStatus @default(PENDING)
  approverUserId   String?
  approverRole     String?
  criteriaOrNotes  String?
  decidedAt        DateTime?
  createdAt        DateTime              @default(now())

  processVersion ProcessVersion @relation(fields: [processVersionId], references: [id], onDelete: Cascade)

  @@index([processVersionId])
  @@index([status])
}

/// Owner-managed swimlane — presentation / responsibility grouping only.
model ProcessSwimlane {
  id               String              @id @default(cuid())
  processVersionId String
  name             String
  kind             ProcessSwimlaneKind @default(ROLE)
  displayOrder     Int                 @default(0)
  colorHint        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  processVersion ProcessVersion @relation(fields: [processVersionId], references: [id], onDelete: Cascade)
  steps          ProcessStep[]

  @@index([processVersionId, displayOrder])
}

model ProcessPainPoint {
  id                     String            @id @default(cuid())
  processVersionId       String
  processStepId          String?
  processConnectionId    String?
  title                  String
  description            String?
  category               PainPointCategory @default(OTHER)
  severity               PainPointSeverity @default(MEDIUM)
  frequency              String?
  estimatedTimeImpact    String?
  estimatedFinancialImpact String?
  financialImpactSource  String?
  customerImpact         String?
  complianceOrOpsRisk    String?
  evidenceSource         String?
  currentWorkaround      String?
  confidence             String?
  ownerNotes             String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  processVersion ProcessVersion            @relation(fields: [processVersionId], references: [id], onDelete: Cascade)
  processStep    ProcessStep?              @relation(fields: [processStepId], references: [id], onDelete: SetNull)
  opportunities  ImprovementOpportunity[]

  @@index([processVersionId])
  @@index([processStepId])
  @@index([category])
  @@index([severity])
}

model ProcessMetric {
  id               String           @id @default(cuid())
  processVersionId String
  processStepId    String?
  name             String
  description      String?
  metricType       MetricType       @default(OTHER)
  currentValue     String?
  unit             String?
  targetValue      String?
  measurementPeriod String?
  dataSource       MetricDataSource @default(OWNER_ESTIMATE)
  confidence       String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  processVersion ProcessVersion           @relation(fields: [processVersionId], references: [id], onDelete: Cascade)
  processStep    ProcessStep?             @relation(fields: [processStepId], references: [id], onDelete: SetNull)
  opportunities  ImprovementOpportunity[]

  @@index([processVersionId])
  @@index([processStepId])
  @@index([metricType])
}

model ImprovementOpportunity {
  id                 String               @id @default(cuid())
  processVersionId   String
  processStepId      String?
  processConnectionId String?
  painPointId        String?
  metricId           String?
  title              String
  problemAddressed   String?
  proposedChange     String?
  category           ImprovementCategory  @default(OTHER)
  expectedBenefit    String?
  estimatedImpact    String?
  estimatedEffort    String?
  priority           ImprovementPriority  @default(MEDIUM)
  confidence         String?
  dependencies       String?
  risks              String?
  assumptions        String?
  validationNeeded   String?
  status             ImprovementStatus    @default(CAPTURED)
  ownerNotes         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  processVersion ProcessVersion    @relation(fields: [processVersionId], references: [id], onDelete: Cascade)
  processStep    ProcessStep?      @relation(fields: [processStepId], references: [id], onDelete: SetNull)
  painPoint      ProcessPainPoint? @relation(fields: [painPointId], references: [id], onDelete: SetNull)
  metric         ProcessMetric?    @relation(fields: [metricId], references: [id], onDelete: SetNull)

  @@index([processVersionId])
  @@index([processStepId])
  @@index([painPointId])
  @@index([metricId])
  @@index([status])
  @@index([priority])
}

model Tool {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())

  companyTools CompanyTool[]
}

model CompanyTool {
  id              String   @id @default(cuid())
  companyId       String?
  formResponseId  String?
  toolId          String?
  name            String
  category        String?
  usedFor         String?
  whoUses         String?
  informationHeld String?
  connectsTo      String?
  worksWell       String?
  doesNotWorkWell String?
  costOptional    String?
  retainDecision  String?
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  formResponse FormResponse? @relation(fields: [formResponseId], references: [id], onDelete: Cascade)
  tool         Tool?         @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([formResponseId])
}

model FileAttachment {
  id               String          @id @default(cuid())
  storageKey       String          @unique
  originalName     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  accessLevel      FileAccessLevel @default(OWNER_ONLY)
  category         String?
  companyId        String?
  contactId        String?
  opportunityId    String?
  invitationId     String?
  formResponseId   String?
  uploadedByOwner  Boolean         @default(false)
  createdAt        DateTime        @default(now())

  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  invitation   FormInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  formResponse FormResponse?  @relation(fields: [formResponseId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([invitationId])
  @@index([formResponseId])
}

model Activity {
  id            String   @id @default(cuid())
  type          String
  summary       String
  detailsJson   String   @default("{}")
  actorType     String   @default("system")
  actorLabel    String?
  opportunityId String?
  contactId     String?
  companyId     String?
  invitationId  String?
  createdAt     DateTime @default(now())

  opportunity Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  invitation  FormInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
  @@index([contactId, createdAt])
  @@index([companyId, createdAt])
}

model Note {
  id            String   @id @default(cuid())
  body          String
  authorUserId  String?
  opportunityId String?
  contactId     String?
  companyId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([contactId])
  @@index([companyId])
}

model Meeting {
  id            String        @id @default(cuid())
  title         String
  meetingType   String
  status        MeetingStatus @default(SCHEDULED)
  scheduledAt   DateTime?
  completedAt   DateTime?
  locationOrUrl String?
  notes         String?
  opportunityId String?
  contactId     String?
  companyId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([scheduledAt])
}

model NextAction {
  id            String           @id @default(cuid())
  title         String
  description   String?
  status        NextActionStatus @default(OPEN)
  dueAt         DateTime?
  completedAt   DateTime?
  opportunityId String?
  assigneeId    String?
  source        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([opportunityId, status])
  @@index([dueAt])
  @@index([status])
}

model Proposal {
  id            String         @id @default(cuid())
  opportunityId String?
  companyId     String?
  title         String
  status        ProposalStatus @default(DRAFT)
  amountCents   Int?
  summary       String?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Agreement {
  id            String          @id @default(cuid())
  opportunityId String?
  companyId     String?
  title         String
  status        AgreementStatus @default(DRAFT)
  signedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Payment {
  id            String        @id @default(cuid())
  opportunityId String?
  companyId     String?
  title         String
  status        PaymentStatus @default(DRAFT)
  amountCents   Int?
  dueAt         DateTime?
  paidAt        DateTime?
  externalRef   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Project {
  id            String        @id @default(cuid())
  opportunityId String?
  companyId     String?
  name          String
  status        ProjectStatus @default(PLANNED)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  opportunity Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stages      ProjectStage[]
}

model ProjectStage {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  sortOrder  Int       @default(0)
  status     String    @default("pending")
  startedAt  DateTime?
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Sop {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  stageSlug   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Template {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  kind        String
  body        String
  stageSlug   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  actorUserId String?
  actorLabel String   @default("system")
  entityType String?
  entityId   String?
  detailsJson String  @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Increment 4 — Blueprint evidence foundation (additive)
// ---------------------------------------------------------------------------

enum BlueprintMeetingStatus {
  PLANNED
  COMPLETED
  EVIDENCE_PROCESSING
  AWAITING_OWNER_REVIEW
  REVIEWED
  SUPERSEDED
  ARCHIVED
}

enum EvidenceSourceType {
  QUESTIONNAIRE_RESPONSE
  QUESTIONNAIRE_PROCESS
  BLUEPRINT_TRANSCRIPT
  CONSULTANT_NOTE
  CLIENT_NOTE
  ATTACHMENT
  OWNER_OBSERVATION
  OWNER_ESTIMATE
  VERIFIED_MEASUREMENT
  CLIENT_CONFIRMED_FACT
  DECISION
  ASSUMPTION
  EXTERNAL_RESEARCH
  SYSTEM_DERIVED_VALIDATION
}

enum EvidenceSourceStatus {
  DRAFT
  FINALIZED
  SUPERSEDED
}

enum EvidenceFindingCategory {
  BUSINESS_OBJECTIVE
  PROCESS
  PROCESS_STEP
  TRIGGER
  OUTCOME
  ROLE
  SOFTWARE_SYSTEM
  MANUAL_TASK
  PAIN_POINT
  BOTTLENECK
  EXCEPTION
  METRIC
  TIME_ESTIMATE
  COST_ESTIMATE
  RISK
  REQUIREMENT
  CONSTRAINT
  PREFERENCE
  DECISION
  ASSUMPTION
  OPEN_QUESTION
  FOLLOW_UP_ITEM
  IMPROVEMENT_IDEA
  OTHER
}

enum EvidenceFindingReviewStatus {
  PROPOSED
  ACCEPTED
  CORRECTED_AND_ACCEPTED
  REJECTED
  DUPLICATE
  NEEDS_CLARIFICATION
  SUPERSEDED
}

enum EvidenceConflictStatus {
  UNRESOLVED
  NEEDS_CLIENT_CONFIRMATION
  RESOLVED_SOURCE_A
  RESOLVED_SOURCE_B
  RESOLVED_CORRECTED
  BOTH_VALID
  NOT_MATERIAL
  DEFERRED
}

enum EvidenceConflictMateriality {
  LOW
  MEDIUM
  HIGH
}

enum EvidenceExtractionMethod {
  MANUAL_OWNER
  DETERMINISTIC
  PROPOSED_AI
}

model BlueprintMeeting {
  id                 String                 @id @default(cuid())
  companyId          String
  opportunityId      String
  formResponseId     String?
  title              String
  meetingDate        DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  durationMinutes    Int?
  facilitatorLabel   String?
  status             BlueprintMeetingStatus @default(PLANNED)
  processingStatus   String?
  reviewStatus       String?
  summaryManual      String?
  decisionsJson      String                 @default("[]")
  openQuestionsJson  String                 @default("[]")
  followUpsJson      String                 @default("[]")
  createdByUserId    String?
  updatedByUserId    String?
  supersededById     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity  Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  formResponse FormResponse? @relation(fields: [formResponseId], references: [id], onDelete: SetNull)
  attendees    BlueprintMeetingAttendee[]
  processes    BlueprintMeetingProcess[]
  sources      EvidenceSource[]
  findings     EvidenceFinding[]
  conflicts    EvidenceConflict[]

  @@index([companyId])
  @@index([opportunityId])
  @@index([formResponseId])
  @@index([status])
}

model BlueprintMeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  name      String
  role      String?
  email     String?
  isClient  Boolean @default(true)

  meeting BlueprintMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model BlueprintMeetingProcess {
  id        String @id @default(cuid())
  meetingId String
  processId String

  meeting BlueprintMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, processId])
  @@index([processId])
}

/// Immutable after FINALIZED. Corrections create a new source or finding version.
model EvidenceSource {
  id               String               @id @default(cuid())
  companyId        String
  opportunityId    String?
  formResponseId   String?
  meetingId        String?
  processId        String?
  sourceType       EvidenceSourceType
  status           EvidenceSourceStatus @default(DRAFT)
  title            String
  bodyText         String               @default("")
  originalBodyText String               @default("")
  authorLabel      String?
  speakerNotesJson String?
  fileName         String?
  mimeType         String?
  byteSize         Int?
  storageKey       String?
  version          Int                  @default(1)
  parentSourceId   String?
  isSensitive      Boolean              @default(false)
  isIrrelevant     Boolean              @default(false)
  createdByUserId  String?
  finalizedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  formResponse FormResponse?     @relation(fields: [formResponseId], references: [id], onDelete: SetNull)
  meeting      BlueprintMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  findings     EvidenceFinding[]
  conflictAsA  EvidenceConflict[] @relation("ConflictSourceA")
  conflictAsB  EvidenceConflict[] @relation("ConflictSourceB")

  @@index([companyId])
  @@index([opportunityId])
  @@index([meetingId])
  @@index([formResponseId])
  @@index([sourceType, status])
}

model EvidenceFinding {
  id                 String                      @id @default(cuid())
  companyId          String
  opportunityId      String?
  meetingId          String?
  processId          String?
  sourceId           String
  category           EvidenceFindingCategory     @default(OTHER)
  title              String
  body               String                      @default("")
  excerpt            String?
  sourceLocation     String?
  speakerOrAuthor    String?
  confidence         String?
  extractionMethod   EvidenceExtractionMethod    @default(MANUAL_OWNER)
  reviewStatus       EvidenceFindingReviewStatus @default(PROPOSED)
  correctedTitle     String?
  correctedBody      String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  duplicateOfId      String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  meeting     BlueprintMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  source      EvidenceSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  conflictsA  EvidenceConflict[] @relation("ConflictFindingA")
  conflictsB  EvidenceConflict[] @relation("ConflictFindingB")

  @@index([companyId])
  @@index([opportunityId])
  @@index([meetingId])
  @@index([sourceId])
  @@index([processId])
  @@index([reviewStatus])
}

model EvidenceConflict {
  id                      String                     @id @default(cuid())
  companyId               String
  opportunityId           String?
  meetingId               String?
  processId               String?
  subject                 String
  explanation             String?
  materiality             EvidenceConflictMateriality @default(MEDIUM)
  status                  EvidenceConflictStatus      @default(UNRESOLVED)
  sourceAId               String?
  sourceBId               String?
  findingAId              String?
  findingBId              String?
  statementA              String
  statementB              String
  resolutionRationale     String?
  correctedValue          String?
  requiresClientConfirm   Boolean                     @default(false)
  resolvedByUserId        String?
  resolvedAt              DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  meeting     BlueprintMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  sourceA     EvidenceSource?   @relation("ConflictSourceA", fields: [sourceAId], references: [id], onDelete: SetNull)
  sourceB     EvidenceSource?   @relation("ConflictSourceB", fields: [sourceBId], references: [id], onDelete: SetNull)
  findingA    EvidenceFinding?  @relation("ConflictFindingA", fields: [findingAId], references: [id], onDelete: SetNull)
  findingB    EvidenceFinding?  @relation("ConflictFindingB", fields: [findingBId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([opportunityId])
  @@index([meetingId])
  @@index([status])
}
