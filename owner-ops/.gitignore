# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# local sqlite + private uploads (never public)
/prisma/*.db
/prisma/*.db-journal
/prisma/vitest.db
/prisma/test-invitations.db
/storage/**
!/storage/.gitkeep
/storage/uat-demo/
/storage-test
/coverage

# Local UAT demo seed (may be present for acceptance; do not commit raw tokens)
prisma/seed-demo-uat.ts

